#!/bin/sh
set -eu
export REPOSHELF_PACKAGED=1
export REPOSHELF_DATA_DIR="${XDG_DATA_HOME:-"$HOME/.local/share"}/reposhelf/data"
python_version="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
export PYTHONPATH="/app/lib/python${python_version}/site-packages${PYTHONPATH:+:$PYTHONPATH}"
exec python3 /app/lib/reposhelf/desktop_app.py "$@"
